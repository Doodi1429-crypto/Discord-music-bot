{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "A Discord music bot supporting YouTube, SoundCloud (search, tracks, playlists) and direct media URLs.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "postinstall": "node scripts/install-runtime.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.28.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "youtubei.js": "^18.3.0"
  }
}
