DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: set this to an installed ffmpeg executable when ffmpeg-static is unavailable
# (e.g. its postinstall download was blocked by the hosting provider).
FFMPEG_PATH=

# Optional: YouTube resolution works entirely in Node.js (via youtubei.js) and does not
# require yt-dlp/youtube-dl. If set, or if yt-dlp/youtube-dl is found on PATH, it is used
# only as a fallback when the built-in resolver fails.
YOUTUBE_DL_PATH=

# Optional: only used when the yt-dlp fallback above is enabled. YouTube may require
# authentication for some requests (e.g. "Sign in to confirm you're not a bot"). To
# support this, you can point yt-dlp at your own externally-mounted config file and/or
# cookies file; their paths are passed to yt-dlp as plain arguments and never logged,
# and their contents are never read or logged by this bot. Operators are responsible
# for exporting valid cookies from a logged-in browser session (e.g. with a browser
# extension) and/or installing and configuring a yt-dlp-supported PO Token provider
# plugin as described in yt-dlp's documentation - see
# https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide and
# https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# Do NOT commit real cookies/config files; keep them outside the repository and/or
# gitignored. Tokens and cookies are often session-bound and may expire or be revoked,
# and this configuration does not bypass YouTube's IP-based rate limiting/restrictions.
YOUTUBE_DL_CONFIG_PATH=
YOUTUBE_DL_COOKIES_PATH=
LOG_LEVEL=info

# Optional: milliseconds to wait for client.login() to complete before treating it as a hang
# and exiting with a diagnostic error (e.g. when a host's firewall silently drops the Discord
# gateway connection, which otherwise hangs forever with no output). Defaults to 30000 (30s).
LOGIN_TIMEOUT_MS=
