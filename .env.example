DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: set this to an installed ffmpeg executable when ffmpeg-static is unavailable
# (e.g. its postinstall download was blocked by the hosting provider).
FFMPEG_PATH=

# The bot uses yt-dlp or youtube-dl from PATH when available. Set this to an executable path
# to override automatic discovery (for example, when the binary is installed outside PATH).
YOUTUBE_DL_PATH=
LOG_LEVEL=info
