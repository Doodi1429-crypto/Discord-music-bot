DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: set this to an installed ffmpeg executable when ffmpeg-static is unavailable
# (e.g. its postinstall download was blocked by the hosting provider).
FFMPEG_PATH=

# Optional: set this to an installed yt-dlp/youtube-dl executable when youtube-dl-exec's
# bundled binary is unavailable (e.g. its postinstall download was blocked by the hosting
# provider, such as some restricted Node.js hosting environments).
YOUTUBE_DL_PATH=
LOG_LEVEL=info
