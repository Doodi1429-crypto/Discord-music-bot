DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: set this to an installed ffmpeg executable when ffmpeg-static is unavailable
# (e.g. its postinstall download was blocked by the hosting provider).
FFMPEG_PATH=

# Optional: YouTube resolution works entirely in Node.js (via youtubei.js) and does not
# require yt-dlp/youtube-dl. `npm install` automatically downloads a standalone yt-dlp
# binary for supported platforms (see scripts/install-yt-dlp.js), so it's discoverable
# without setting anything here. Set this to override with your own installed/managed
# yt-dlp/youtube-dl executable instead (skips the automatic download); it is used only
# as a fallback when the built-in resolver fails.
YOUTUBE_DL_PATH=

# Optional: set to any non-empty value to skip the automatic yt-dlp download performed
# by `npm install` (e.g. offline development, or intentionally running without the
# yt-dlp fallback). Has no effect when YOUTUBE_DL_PATH is already set.
YOUTUBE_DL_SKIP_INSTALL=

# Optional: only used when the yt-dlp fallback above is enabled.
# The official standalone Linux executable downloaded by scripts/install-yt-dlp.js
# bundles yt-dlp-ejs per official EJS documentation (no extra EJS packages needed).
# The installer logs the downloaded version during build, but because it is not
# version-pinned, the live version on Render must be verified from Render's build logs.
#
# Node runtime requirements:
# yt-dlp requires an external JS runtime to solve YouTube player challenges (signatures/n-sig);
# current official yt-dlp documentation states `--js-runtimes node` requires Node >= 22.
# Although package.json specifies engines >= 24.17.0, Render's actual installed Node
# runtime must be verified from deployment logs.
#
# YouTube player client selection & bot challenges:
# Current official YouTube extractor documentation states yt-dlp uses default clients that
# currently do not require PO tokens, and recommends `mweb` *with a PO Token* when defaults fail.
# Therefore, unconditionally forcing `player_client=mweb,default` is not supported as a general
# no-token headless configuration. By default, YOUTUBE_DL_PLAYER_CLIENT is left unset (null),
# leaving yt-dlp's own built-in client policy in control.
#
# "Sign in to confirm you're not a bot" is consistent with an upstream bot-verification challenge
# (which can be triggered by IP reputation, rate limits, player client selection, or PO token
# requirements), and only Render-side verbose diagnostics can establish the precise trigger.
# If yt-dlp's normal defaults still receive the challenge, no code-only config change can
# guarantee bypassing YouTube's challenge without operator-supplied PO tokens, provider plugins,
# or cookies.
#
# The following options allow operators to configure extraction without modifying code:
# - YOUTUBE_DL_JS_RUNTIMES: JavaScript runtime passed via `--js-runtimes` (default: 'node').
#   Enabling 'node' allows yt-dlp to solve challenges in Node container environments without Deno.
#   Set to 'none' to omit passing `--js-runtimes`.
# - YOUTUBE_DL_PLAYER_CLIENT: Player client preference passed via `--extractor-args "youtube:player_client=..."`.
#   Defaults to unset (null), allowing yt-dlp's built-in client policy to govern selection.
#   Set to a specific client (e.g. 'mweb' when using a PO token) or 'none' to explicitly omit.
# - YOUTUBE_DL_PO_TOKEN: Proof of Origin token (e.g. 'web+<token>' or '<token>'). Masked in logs and errors.
# - YOUTUBE_DL_POT_PROVIDER_URL: URL to an external PO token provider (e.g. http://127.0.0.1:4444 or bgutil service).
# - YOUTUBE_DL_EXTRACTOR_ARGS: Custom extractor args passed as `--extractor-args` (e.g. 'youtube:player_client=mweb').
# - YOUTUBE_DL_CONFIG_PATH: Path to a yt-dlp configuration file.
# - YOUTUBE_DL_COOKIES_PATH: Path to an exported Netscape-format cookies file.
#
# For details on generating PO tokens or running token providers:
# - https://github.com/yt-dlp/yt-dlp/wiki/EJS
# - https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
# - https://github.com/yt-dlp/yt-dlp/wiki/Extractors#youtube
# - https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
#
# Do NOT commit cookies or tokens to source control; use environment variables or secret mounts.
YOUTUBE_DL_JS_RUNTIMES=
YOUTUBE_DL_PLAYER_CLIENT=
YOUTUBE_DL_PO_TOKEN=
YOUTUBE_DL_POT_PROVIDER_URL=
YOUTUBE_DL_EXTRACTOR_ARGS=
YOUTUBE_DL_CONFIG_PATH=
YOUTUBE_DL_COOKIES_PATH=
# Temporarily enable verbose yt-dlp diagnostics. Output is sanitized before logging.
YOUTUBE_DL_DEBUG=
LOG_LEVEL=info

# Optional: milliseconds to wait for client.login() to complete before treating it as a hang
# and exiting with a diagnostic error (e.g. when a host's firewall silently drops the Discord
# gateway connection, which otherwise hangs forever with no output). Defaults to 30000 (30s).
LOGIN_TIMEOUT_MS=
