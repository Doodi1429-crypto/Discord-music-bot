DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: set this to an installed ffmpeg executable when ffmpeg-static is unavailable
# (e.g. its postinstall download was blocked by the hosting provider).
FFMPEG_PATH=

# Optional: YouTube resolution works entirely in Node.js (via youtubei.js) and does not
# require yt-dlp/youtube-dl. If set, or if yt-dlp/youtube-dl is found on PATH, it is used
# only as a fallback when the built-in resolver fails.
YOUTUBE_DL_PATH=
LOG_LEVEL=info

# Optional: milliseconds to wait for client.login() to complete before treating it as a hang
# and exiting with a diagnostic error (e.g. when a host's firewall silently drops the Discord
# gateway connection, which otherwise hangs forever with no output). Defaults to 30000 (30s).
LOGIN_TIMEOUT_MS=
